<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.it.dorm.mapper.DormBuildMapper">
    
    <resultMap type="DormBuild" id="DormBuildResult">
        <result property="id"    column="id"    />
        <result property="buildId"    column="build_id"    />
        <result property="buildName"    column="build_name"    />
        <result property="buildDetail"    column="build_detail"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectDormBuildVo">
        select id, build_id, build_name, build_detail, remark, create_by, create_time, update_by, update_time from dorm_build
    </sql>

    <select id="selectDormBuildList" parameterType="DormBuild" resultMap="DormBuildResult">
        <include refid="selectDormBuildVo"/>
        <where>  
            <if test="buildId != null "> and build_id = #{buildId}</if>
            <if test="buildName != null  and buildName != ''"> and build_name like concat('%', #{buildName}, '%')</if>
            <if test="buildDetail != null  and buildDetail != ''"> and build_detail = #{buildDetail}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectDormBuildById" parameterType="Long" resultMap="DormBuildResult">
        <include refid="selectDormBuildVo"/>
        where id = #{id}
    </select>

    <insert id="insertDormBuild" parameterType="DormBuild">
        insert into dorm_build
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="buildId != null">build_id,</if>
            <if test="buildName != null and buildName != ''">build_name,</if>
            <if test="buildDetail != null and buildDetail != ''">build_detail,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="buildId != null">#{buildId},</if>
            <if test="buildName != null and buildName != ''">#{buildName},</if>
            <if test="buildDetail != null and buildDetail != ''">#{buildDetail},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateDormBuild" parameterType="DormBuild">
        update dorm_build
        <trim prefix="SET" suffixOverrides=",">
            <if test="buildId != null">build_id = #{buildId},</if>
            <if test="buildName != null and buildName != ''">build_name = #{buildName},</if>
            <if test="buildDetail != null and buildDetail != ''">build_detail = #{buildDetail},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDormBuildById" parameterType="Long">
        delete from dorm_build where id = #{id}
    </delete>

    <delete id="deleteDormBuildByIds" parameterType="String">
        delete from dorm_build where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>